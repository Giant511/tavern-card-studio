#!/bin/sh
# pre-commit：改 PLAN.md 时校验决策表序号连续性；
#              改 CLI 命令面或运维手册时校验 docs/server-cmd.md 与实现一致。
#
# 为什么只在 PLAN.md 进暂存区时才检查：
#   钩子必须快（<0.5s），否则会被 `--no-verify` 绕过而形同虚设。
#   这条检查只读一个文件、只跑 node，代价极低。
#
# 为什么需要它：决策表追加条目时容易把相邻行一起吃进替换范围，
# 导致条目被静默删除（2026-10-21 一天内发生两次）。编号跳号就是丢条目的信号。
#
# 注意：PLAN.md 与 docs/ 已从版本库撤下（T9.13 文档分层），本地保留。
#   因此在别人的干净 clone 上这个钩子不会触发 —— 这是预期的，决策表只对
#   本地开发有意义。要绕过本地忽略规则强制校验，可手工跑
#   `node scripts/check-decision-table.mjs`。
#
# 启用方式（每个克隆执行一次）：
#   git config core.hooksPath scripts/hooks
# 或在 Windows 上：
#   powershell -File scripts/enable-hooks.ps1

set -e

if git diff --cached --name-only --diff-filter=ACM | grep -qx 'PLAN\.md'; then
  echo "[pre-commit] 检测到 PLAN.md 变更，校验决策表序号…"
  if ! node scripts/check-decision-table.mjs; then
    echo ""
    echo "[pre-commit] 提交被拦截：决策表序号不连续，多半是追加条目时吃掉了相邻行。"
    echo "             修好 PLAN.md 后重新 git add。"
    exit 1
  fi
fi

# 运维手册：命令面一变，docs/server-cmd.md 必须同提交更新。
# 触发条件刻意只认三个文件：CLI 命令面的来源（server/src/cli.ts）、
# 运维手册本身、以及开发者对接文档（它逐条抄了命令与端点，同样会漂移）。
# 其它提交不付这个代价 —— `node --test` 单文件约 1 秒，比 0.5 秒的目标慢，
# 但只在"改了命令面或改了手册"时付，这种情况本来就该等。
if git diff --cached --name-only --diff-filter=ACM | grep -qxE 'server/src/cli\.ts|docs/server-cmd\.md|docs/server-developer\.md'; then
  echo "[pre-commit] 检测到运维命令面 / 开发者文档变更，校验 docs/server-cmd.md 与 docs/server-developer.md…"
  if ! node --test test/ops-doc.test.mjs > /tmp/tcs-ops-doc.log 2>&1; then
    grep -E '^not ok|手册缺少|这些行|只能有' /tmp/tcs-ops-doc.log | sed 's/^/    /'
    echo ""
    echo "[pre-commit] 提交被拦截：运维手册与 CLI 命令面不一致，或 .gitignore 放行了额外的 docs 文件。"
    echo "             补好 docs/server-cmd.md（或回复 .gitignore）后重新 git add。"
    exit 1
  fi
fi

exit 0
