{
  "name": "tavern-card-studio",
  "private": true,
  "version": "0.1.2",
  "description": "酒馆（SillyTavern）角色卡审计与编辑工具链：服务端（版本控制/审计）+ 客户端（分块编辑器）",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "validate:rules": "node scripts/validate-rules.mjs",
    "typecheck": "tsc -p shared/tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit",
    "build": "tsc -b --pretty false",
    "build:shared": "tsc -b shared",
    "build:server": "tsc -b server",
    "test": "npm run build:shared && npm run build:server && node --test \"test/*.test.mjs\"",
    "preview:highlight": "node scripts/render-highlight-preview.mjs",
    "gen:audit-sample": "npm run build:shared && node scripts/gen-audit-sample.mjs",
    "server": "node server/dist/index.js serve",
    "server:worker": "node server/dist/index.js worker",
    "demo:server": "npm run build:server && node scripts/demo-server.mjs",
    "pack:server": "npm run build:server && node scripts/pack-server.mjs",
    "gen:wix": "node scripts/gen-wix-fragment.mjs",
    "typecheck:client": "npm run typecheck --workspace @tcs/client",
    "build:ui": "npm run build:ui --workspace @tcs/client",
    "validate:client": "node client/scripts/validate-config.mjs",
    "check:decisions": "node scripts/check-decision-table.mjs",
    "check:readme": "node scripts/check-readme.mjs",
    "check:unknown-keys": "npm run build:shared && node scripts/check-unknown-keys.mjs",
    "check:ops-doc": "node --test test/ops-doc.test.mjs",
    "scan:entropy": "node scripts/scan-entropy.mjs",
    "enable:hooks": "node scripts/enable-hooks.mjs",
    "verify:import-atomic": "node scripts/verify-import-atomic.mjs",
    "verify:export-roundtrip": "node scripts/verify-export-roundtrip.mjs",
    "verify:sync-live": "node scripts/verify-sync-live.mjs",
    "validate:examples": "node scripts/validate-examples.mjs",
    "gen:examples": "node scripts/gen-examples.mjs",
    "verify:e2e": "node scripts/verify-e2e.mjs",
    "verify:audit-panel": "node scripts/verify-audit-panel.mjs",
    "verify:highlight-live": "node scripts/verify-highlight-live.mjs",
    "diagnose:rules": "node scripts/diagnose-rules.mjs",
    "compare:highlight": "node scripts/compare-highlight.mjs",
    "shot:newcard": "node scripts/shot-newcard.mjs",
    "verify:t107": "node scripts/verify-t107.mjs",
    "probe:shortsha": "node scripts/probe-shortsha.mjs",
    "smoke:t108": "node scripts/smoke-t108.mjs",
    "verify:t108": "node scripts/verify-t108.mjs",
    "verify:t109": "node scripts/verify-t109.mjs",
    "verify:t113": "node scripts/verify-t113-authgate.mjs",
    "verify:t1020": "node scripts/verify-t1020-ui.mjs",
    "verify:t110-matrix": "node scripts/verify-t110-matrix.mjs",
    "smoke:t105": "node scripts/smoke-t105.mjs",
    "smoke:t106": "node scripts/smoke-t106.mjs",
    "smoke:t110-ca": "node scripts/smoke-t110-custom-ca.mjs",
    "smoke:t110-deploy": "node scripts/smoke-t110-deploy.mjs",
    "report:release": "node scripts/report-release.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "ajv": "^8.17.1",
    "typescript": "^5.6.3"
  }
}
