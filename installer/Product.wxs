<?xml version="1.0" encoding="UTF-8"?>
<!--
  Tavern Card Studio Server — WiX v4/v5 installer source.

  Build with installer\build-msi.ps1:
    1. npm run pack:server            (stages node.exe + app + runtime deps)
    2. node scripts/gen-wix-fragment.mjs  (generates installer\generated\AppFiles.wxs)
    3. wix build installer\Product.wxs installer\generated\AppFiles.wxs ...

  Installed layout:
    C:\Program Files\Tavern Card Studio Server\
      node.exe
      tcs-service-host.exe     WinSW: the SCM-facing process (node.exe cannot be one)
      tcs-service-host.xml     WinSW config: spawns node.exe, logs to ProgramData
      app\server\dist\...      API + supervisor
      app\server\public\...    admin panel
      app\rules\...            platform / preset / highlight rules
      app\node_modules\...     runtime dependencies
    C:\ProgramData\TavernCardStudio\   data root (config.json, store\, logs\)

  The data directory is intentionally NOT removed on uninstall: it holds card
  blobs, git repositories and audit snapshots.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package

    Name="Tavern Card Studio Server"
    Language="1033"
    Version="$(var.ProductVersion)"
    Manufacturer="Tavern Card Studio"
    UpgradeCode="7F1D6F2C-4B7E-4C1A-9F3E-2D6C5A8B1E90"
    Scope="perMachine"
    Compressed="yes">

    <SummaryInformation
      Description="Character card audit and version control server (local deployment)."
      Manufacturer="Tavern Card Studio" />

    <MajorUpgrade
      DowngradeErrorMessage="A newer version of Tavern Card Studio Server is already installed."
      Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPCOMMENTS" Value="Local-first character card audit and version control server. Data lives in C:\ProgramData\TavernCardStudio." />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Tavern Card Studio Server" />
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DATAFOLDER" Name="TavernCardStudio" />
    </StandardDirectory>

    <Feature Id="MainFeature" Title="Tavern Card Studio Server" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="ServiceComponent" />
      <ComponentRef Id="DataFolderComponent" />
      <ComponentRef Id="ConnectGuideComponent" />
      <ComponentRef Id="StartMenuShortcutComponent" />
    </Feature>

    <!--
      安装完成后打开连接说明。

      **必须在 Package 内**，不能放在 Fragment 里 —— 放在 Fragment 里 WiX 会静默忽略整段，
      构建照样成功、MSI 里却没有这条动作（2026-10-22 实测：反编译后 CustomAction 表为空，
      而构建日志一条警告都没有）。这类"静默不生效"只能靠解包反编译发现。

      条件：
        · NOT REMOVE —— 卸载时不弹；
        · UILevel >= 3 —— 静默安装（/qn，UILevel=2）时不弹，
          否则在无人值守部署里会突然弹出一个浏览器窗口。
    -->
    <InstallExecuteSequence>
      <Custom Action="OpenConnectGuide" After="InstallFinalize"
              Condition="NOT REMOVE AND UILevel &gt;= 3" />
    </InstallExecuteSequence>
  </Package>

  <!-- Data directory: created at install, kept at uninstall. -->
  <Fragment>
    <DirectoryRef Id="DATAFOLDER">
      <Component Id="DataFolderComponent" Guid="2C0B8B6A-6E5F-4B3D-9E44-8A7D1C3F5B21">
        <CreateFolder />
        <RegistryValue Root="HKLM" Key="Software\TavernCardStudio" Name="DataDir" Type="string" Value="[DATAFOLDER]" KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>

  <!--
    Service host.

    node.exe is NOT a service host: it never calls StartServiceCtrlDispatcher, so
    the SCM waits forever for SERVICE_RUNNING and the service stays `Start Pending`.
    With <ServiceInstall> pointing at node.exe directly, msiexec hangs at
    "Please wait while Windows configures ..." (reproduced 2026-10-21; the node
    process was up and listening on 8730/8731 the whole time, which made it look
    like a hang in the wrong place).

    Fix: WinSW (vendor\winsw\WinSW.NET4.exe, 832 KiB) is the SCM-facing process;
    it spawns node.exe from tcs-service-host.xml, reports RUNNING, captures
    stdout/stderr to %ProgramData%\TavernCardStudio\logs, and restarts on failure.

    Component GUID changed on purpose: KeyPath moved from node.exe to the host exe,
    and a component's resources must stay fixed for a given GUID.
  -->
  <Fragment>
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="ServiceComponent" Guid="03336D46-B75F-4A36-8605-B60D664DEF28">
        <File Id="NodeExe" Source="$(var.StageDir)\node.exe" />
        <File Id="ServiceHostExe" Source="$(var.WinSwDir)\WinSW.NET4.exe" Name="tcs-service-host.exe" KeyPath="yes" />
        <File Id="ServiceHostConfig" Source="$(var.ServiceHostConfig)" Name="tcs-service-host.xml" />
        <ServiceInstall
          Id="ServerServiceInstaller"
          Name="TavernCardStudioServer"
          DisplayName="Tavern Card Studio Server"
          Description="Tavern Card Studio: character card storage, audit and git-based version control."
          Type="ownProcess"
          Start="auto"
          ErrorControl="normal"
          Account="LocalSystem" />
        <!--
          No Arguments on purpose. WinSW v2 does NOT accept a config path as a
          command-line argument: it looks for `<exe-name>.xml` next to itself and
          aborts with "Unable to locate WinSW.NET4.[xml|yml] file within executable
          directory" otherwise (verified by running the trial config directly).
          So the pairing is name-based and must stay exact:
              tcs-service-host.exe  <->  tcs-service-host.xml
          Renaming only one of them silently breaks the service.
        -->
        <ServiceControl
          Id="ServerServiceControl"
          Name="TavernCardStudioServer"
          Start="install"
          Stop="both"
          Remove="uninstall"
          Wait="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>

  <!--
    Connect guide.

    装完服务端后，用户最需要知道的两件事是「面板地址」和「令牌在哪」。
    以前这两条只写在 docs/09 里（"令牌见 ProgramData\\...\\logs 下日志"），
    用户得自己去找 —— 现在改成装完直接给他看。

    为什么用 HTML + 安装完成后打开，而不是服务启动时弹窗：
    服务由 WinSW 托管、以 LocalSystem 跑在 **session 0**，
    与用户桌面不在同一个会话里，弹不出任何窗口（这正是 F5 里
    "进程活着、端口通、但 SCM 认为没启动" 那段排查时踩到的同一个隔离）。
    能弹窗的只有 msiexec —— 它跑在用户的会话里。所以指引必须由安装程序来打开。

    两个入口都保留：
      · 安装完成后自动打开（CustomAction，异步且不等待，失败不影响安装结果）；
      · 开始菜单快捷方式，用户以后想再看一次也能找到。
  -->
  <Fragment>
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="ConnectGuideComponent" Guid="8E4A1C72-93B5-4D68-A1F7-6C2D9B4E7053">
        <File Id="ConnectGuideHtml" Source="$(var.ConnectGuide)" Name="connect-guide.html" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="Tavern Card Studio Server" />
    </StandardDirectory>

    <DirectoryRef Id="AppMenuFolder">
      <Component Id="StartMenuShortcutComponent" Guid="B3F72D91-5A86-4E3C-8D27-1F4B6A9C2E58">
        <Shortcut
          Id="ConnectGuideShortcut"
          Name="如何连接（地址与令牌）"
          Description="打开连接说明：管理面板地址、API 地址、访问令牌的获取方式"
          Target="[INSTALLFOLDER]connect-guide.html" />
        <RemoveFolder Id="RemoveAppMenuFolder" On="uninstall" />
        <!-- 快捷方式需要一个 KeyPath；用注册表值作为锚点，避免依赖文件是否存在 -->
        <RegistryValue Root="HKLM" Key="Software\TavernCardStudio" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>

  <!--
    安装完成后打开说明页。

    用 `[%ComSpec] /c start "" "<file>"`：靠 shell 关联调起默认浏览器。
    直接写文件路径不行 —— CustomAction 的 ExeCommand 只能执行程序，不能"打开文档"。

    `Return="asyncNoWait"` 是有意的：说明页打不开（例如默认浏览器被策略限制）
    绝不能连带把安装判成失败。装好了就是装好了。
  -->
  <Fragment>
    <CustomAction
      Id="OpenConnectGuide"
      Directory="INSTALLFOLDER"
      ExeCommand="[%ComSpec] /c start &quot;&quot; &quot;[INSTALLFOLDER]connect-guide.html&quot;"
      Execute="immediate"
      Impersonate="yes"
      Return="asyncNoWait" />

  </Fragment>

</Wix>
