{
  "schemaVersion": 1,
  "id": "sillytavern",
  "name": "SillyTavern（原生）",
  "version": "1.0.0",
  "description": "SillyTavern 原生规则。官方对内容写法基本不设限，因此本规则以「结构完整 + 占位符规范」为主：字段缺失为 error，占位符问题只做 info/warning 提示，不阻断导出。",
  "extends": null,
  "target": {
    "spec": "any"
  },
  "placeholders": {
    "char": [
      "{{char}}"
    ],
    "user": [
      "{{user}}"
    ],
    "custom": {
      "persona": [
        "{{persona}}"
      ],
      "original": [
        "{{original}}"
      ]
    }
  },
  "fields": [
    {
      "path": "meta.name",
      "label": "角色名",
      "required": true,
      "minLength": 1,
      "maxLength": 64,
      "severity": "error",
      "message": "角色名（name）不能为空"
    },
    {
      "path": "description",
      "label": "角色描述",
      "required": true,
      "minLength": 1,
      "severity": "error",
      "message": "角色描述（description）不能为空"
    },
    {
      "path": "first_mes",
      "label": "开场白",
      "required": true,
      "minLength": 1,
      "severity": "warning",
      "message": "开场白（first_mes）为空，聊天将没有默认开场"
    },
    {
      "path": "meta.creator",
      "label": "作者",
      "required": false,
      "maxLength": 128,
      "severity": "info"
    }
  ],
  "rules": [
    {
      "id": "char-placeholder-suggested",
      "type": "placeholder-min-count",
      "token": "char",
      "min": 1,
      "scope": [
        "block:basic",
        "block:settings"
      ],
      "severity": "info",
      "message": "正文中未出现 {{char}} 占位符，角色名硬编码后换卡易失效",
      "hint": "建议用 {{char}} 代替角色名，SillyTavern 会自动替换。"
    },
    {
      "id": "user-placeholder-suggested",
      "type": "placeholder-min-count",
      "token": "user",
      "min": 1,
      "scope": "block:user",
      "severity": "info",
      "message": "「用户相关设定」板块未出现 {{user}} 占位符",
      "hint": "建议用 {{user}} 指代玩家角色，避免硬编码「你」。"
    },
    {
      "id": "placeholder-inner-spacing",
      "type": "pattern-forbid",
      "pattern": "\\{\\{\\s+(char|user)\\s+\\}\\}",
      "scope": "*",
      "severity": "warning",
      "message": "占位符内含多余空格，部分前端无法识别",
      "hint": "请写成 {{char}} / {{user}}。"
    },
    {
      "id": "unknown-double-brace",
      "type": "pattern-forbid",
      "pattern": "\\{\\{(?!(char|user|persona|original)\\}\\})",
      "scope": "*",
      "severity": "info",
      "message": "出现非标准 {{...}} 表达，可能被 SillyTavern 当作未知宏",
      "hint": "仅 {{char}}、{{user}}、{{persona}}、{{original}} 会被替换。"
    },
    {
      "id": "basic-block-not-empty",
      "type": "non-empty",
      "scope": "block:basic",
      "severity": "warning",
      "message": "「基本信息」板块为空，角色外貌/身份缺失会影响扮演质量"
    },
    {
      "id": "example-uses-start-marker",
      "type": "pattern-required",
      "pattern": "<START>",
      "scope": "field:mes_example",
      "severity": "warning",
      "message": "对话示例没有用 <START> 分成段落",
      "hint": "每段示例开头单独一行写 <START>，模型才分得清这是「示范」而不是聊天正文。"
    },
    {
      "id": "example-speaker-halfwidth-colon",
      "type": "pattern-forbid",
      "pattern": "^\\s*(用户|角色|助手|USER|User|CHAR|Char|BOT|Bot|AI|Assistant)\\s*：",
      "flags": "m",
      "scope": "field:mes_example",
      "severity": "warning",
      "message": "对话示例用了「用户：」「角色：」这类中文冒号说话人行",
      "hint": "改成 {{user}}: 和 {{char}}:（冒号用半角）。写别的说法时，读卡的一方可能一整段都读不到。"
    },
    {
      "id": "example-macro-halfwidth-colon",
      "type": "pattern-forbid",
      "pattern": "^\\s*\\{\\{\\s*(char|user)\\s*\\}\\}\\s*：",
      "flags": "m",
      "scope": "field:mes_example",
      "severity": "warning",
      "message": "{{char}} / {{user}} 后面跟的是中文冒号",
      "hint": "冒号要用半角 :，全角的匹配不上。"
    },
    {
      "id": "first-mes-not-empty",
      "type": "non-empty",
      "scope": "field:first_mes",
      "severity": "warning",
      "message": "开场白为空，开始新对话时会是空白",
      "hint": "至少写一段开场白；想给多个开局就用「备用开场白」。"
    }
  ],
  "autoFix": [],
  "metadata": {
    "author": "Tavern Card Studio",
    "license": "MIT",
    "updatedAt": "2026-11-05"
  }
}
