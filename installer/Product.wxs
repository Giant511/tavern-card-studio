<?xml version="1.0" encoding="UTF-8"?>
<!--
  Tavern Card Studio Server — WiX v4/v5 installer source.

  Build with installer\build-msi.ps1:
    1. npm run pack:server            (stages node.exe + app + runtime deps)
    2. node scripts/gen-wix-fragment.mjs  (generates installer\generated\AppFiles.wxs)
    3. wix build installer\Product.wxs installer\generated\AppFiles.wxs ...
       -ext <WixToolset.UI.wixext.dll>   (the wizard: see below)

  Installed layout:
    C:\Program Files\Tavern Card Studio Server\
      node.exe
      tcs-service-host.exe     WinSW: the SCM-facing process (node.exe cannot be one)
      tcs-service-host.xml     WinSW config: spawns node.exe, logs to ProgramData
      app\server\dist\...      API + supervisor
      app\server\public\...    admin panel
      app\rules\...            platform / preset / highlight rules
      app\node_modules\...     runtime dependencies
    C:\ProgramData\TavernCardStudio\   data root (config.json, store\, logs\)

  The data directory is NOT removed on uninstall by default: it holds card
  blobs, git repositories and audit snapshots, and deleting it is not
  undoable. Since v0.1.2 the uninstall flow asks (F14.1): a checkbox in
  `DeleteDataDlg`, unchecked unless the user ticks it.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package

    Name="Tavern Card Studio Server"
    Language="1033"
    Version="$(var.ProductVersion)"
    Manufacturer="Tavern Card Studio"
    UpgradeCode="7F1D6F2C-4B7E-4C1A-9F3E-2D6C5A8B1E90"
    Scope="perMachine"
    Compressed="yes">

    <!--
      Codepage 说明：数据库本身用 65001（UTF-8）——安装包里有中文（开始菜单快捷方式叫
      "如何连接（地址与令牌）"），1252 装不下，WiX 会直接 WIX0311 拒绝打包。但
      SummaryInformation 必须用 ANSI 代码页（WIX0349），所以这两处要分开指定。
      在接入向导（ui-text.wxl）之前，WiX 默认给数据库的就是 UTF-8，从没撞上这条；
      一旦有了 en-US 的本地化文件，数据库代码页就跟着变成 1252，问题才浮出来。
    -->
    <SummaryInformation
      Codepage="1252"
      Description="Character card audit and version control server (local deployment)."
      Manufacturer="Tavern Card Studio" />

    <MajorUpgrade
      DowngradeErrorMessage="A newer version of Tavern Card Studio Server is already installed."
      Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" />

    <!--
      ARPNOMODIFY 不在这里写：WixUI_InstallDir 自己会设它（该对话框集不支持 Change），
      我们再写一次会撞 WIX0091 Duplicate Property。这条以前写在 Product 里是能编译的
      （没有界面的 MSI 没人替我设），接上向导之后就成了重复定义。
    -->
    <Property Id="ARPCOMMENTS" Value="Local-first character card audit and version control server. Data lives in C:\ProgramData\TavernCardStudio." />

    <!--
      卸载时是否连带删除数据目录。

      这里**只声明、不给值** —— 空值就是"不勾选"（MSI 的 CheckBox 控件在
      属性值等于 CheckBoxValue 时才显示为勾上）。这正是 F14.1 要求的保守默认：
      误删不可逆，多留一份目录只是占地方。静默卸载时可由命令行显式开启：
        msiexec /x <msi> /qn DELETEDATA=1
    -->
    <Property Id="DELETEDATA" Secure="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Tavern Card Studio Server" />
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DATAFOLDER" Name="TavernCardStudio" />
    </StandardDirectory>

    <Feature Id="MainFeature" Title="Tavern Card Studio Server" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="ServiceComponent" />
      <ComponentRef Id="DataFolderComponent" />
      <ComponentRef Id="ConnectGuideComponent" />
      <ComponentRef Id="LayoutMarkerComponent" />
      <ComponentRef Id="StartMenuShortcutComponent" />
    </Feature>

    <!--
      许可页用的 RTF。WixUI_InstallDir 编译期强制要求这个变量存在，即使我们
      把许可页从流程里摘掉了（见下方 Publish）。文件里是 MIT 全文 + 版权行。

      WixUI_InstallDir 而不是 WixUI_Minimal 的原因：只有它在卸载路径上经过
      VerifyReadyDlg（Minimal 的 Remove 直接 EndDialog 收工），也就是说只有
      它留出了"在 Remove 与 Ready 之间插一页"的位置 —— 那正是我们要问用户
      "要不要删数据"的地方。

      InstallDirectory 会顺带设置 WIXUI_INSTALLDIR，因此目录页拿到的就是
      INSTALLFOLDER（虽然这个页面被我们跳过了，但属性仍然必须合法）。
    -->
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <!--
      自定义界面（F14.1）。WiX v5 只允许 <UI> 作为 <Package> 的直接子元素
      （放 <Fragment> 里会报 WIX0005: unexpected child element 'UI'），
      所以它只能写在 Product 里，不能像文件清单那样拆成独立片段。

      挂载点：标准集的卸载路径是
        MaintenanceWelcomeDlg → MaintenanceTypeDlg → VerifyReadyDlg → 进度 → ExitDialog
      我们把 MaintenanceTypeDlg 的 Remove 改道到 DeleteDataDlg，Next 再回
      VerifyReadyDlg：
        … → MaintenanceTypeDlg →（点 Remove）→ DeleteDataDlg →（点 Next）→ VerifyReadyDlg → …

      **Control 名必须是 RemoveButton**。WiX 里那个按钮的 Control Id 是
      `RemoveButton`，不是 `Remove`；写成 `Remove` 不报错、不警告，编译成功，
      但 ControlEvent 行指向一个不存在的控件 —— 运行时永不触发，表现就是
      "根本没有那一页"。2026-10-24 实测过一次：反编译出来的 MSI 里
      RemoveButton 只剩指向 VerifyReadyDlg 的那一条，构建日志干干净净。
      build-msi.ps1 第 4 步因此断言这条 ControlEvent 真的进了表。

      **Order="2"**：同一控件上的多条 Publish 按 Order 升序全部执行，后执行的
      NewDialog 覆盖先执行的。WiX 自带的 `Remove → VerifyReadyDlg` 是 Order=1，
      我们这条 Order=2 因此最终生效（Tauri 的 MSI 用同样手法跳过许可页）。
    -->
    <UI>
      <Dialog Id="DeleteDataDlg" Width="370" Height="270" Title="[ProductName] Setup" NoMinimize="yes">

        <!-- 坐标沿用 WiX 标准栅格：370×270，按钮 y=243，Back 180 / Next 236 / Cancel 304，各 56×17。
             换成别的值也能跑，但翻页时按钮会跳一下。 -->
        <Control Id="Bitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="234" TabSkip="no" Text="WixUI_Bmp_Dialog" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" TabSkip="no" />

        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="&amp;Back" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Text="&amp;Next" Default="yes" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Text="Cancel" Cancel="yes">
          <!-- 没有这条，Cancel 就是个"点了没反应"的死按钮：Cancel="yes" 只是把它标成
               Cancel 按钮（属性位），并不会自动产生任何动作。WiX 5 的 ICE17 不一定会跑，
               所以这是靠"照标准对话框的写法抄"避免的。 -->
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>

        <Control Id="Title" Type="Text" X="135" Y="15" Width="220" Height="30" Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Bigger}Uninstall options" />
        <Control Id="Description" Type="Text" X="135" Y="48" Width="220" Height="40" Transparent="yes" NoPrefix="yes"
                 Text="Only the program will be removed. Its data directory is separate and is kept by default." />

        <Control Id="DataDirLabel" Type="Text" X="135" Y="92" Width="220" Height="12" Transparent="yes" NoPrefix="yes"
                 Text="Data directory:" />
        <Control Id="DataDirPath" Type="Text" X="135" Y="105" Width="220" Height="24" Transparent="yes" NoPrefix="yes"
                 Text="[DATAFOLDER]" />

        <Control Id="DeleteDataCheck" Type="CheckBox" X="135" Y="135" Width="220" Height="34"
                 Text="Also delete this data directory (card database, configuration, logs)"
                 Property="DELETEDATA" CheckBoxValue="1" />

        <Control Id="Warning" Type="Text" X="135" Y="176" Width="220" Height="48" Transparent="yes" NoPrefix="yes"
                 Text="If you tick the box the data can not be restored: card versions, audit records and account credentials all live there." />
      </Dialog>

      <!-- 本页自己的翻页。注意：Publish 必须是 <UI> 的直接子元素（写进 <Dialog> 里
           会报 WIX0005），靠 Dialog= 属性指明挂在哪个对话框上。Order 用 1 即可 ——
           这两条没有竞争者。 -->
      <Publish Dialog="DeleteDataDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="1" Condition="1" />
      <Publish Dialog="DeleteDataDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="1" Condition="1" />

      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="DeleteDataDlg" Order="2" Condition="1" />

      <!--
        安装路径：Welcome → VerifyReady，跳过许可页与安装目录页。

          · 许可页：本地自用的 MIT 工具，没有人会读那一页，多一次点击只让人觉得
            装起来麻烦（license.rtf 仍然存在，WixUI_InstallDir 编译期要求它）；
          · 安装目录页：自 v0.1.0 起安装位置固定，启动器、服务注册、
            install-layout.ini 都相对它定位。放开选择只会让"路径含空格/中文"
            这类问题重新出现，而没有任何需求要求它。

        VerifyReadyDlg 的 Back 因此也要改回 WelcomeDlg，否则用户在"准备安装"页
        按 Back 会掉进那个被刻意藏起来的目录页。
      -->
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" Condition="NOT Installed" />
    </UI>

    <!--
      安装完成后打开连接说明。

      **必须在 Package 内**，不能放在 Fragment 里 —— 放在 Fragment 里 WiX 会静默忽略整段，
      构建照样成功、MSI 里却没有这条动作（2026-10-22 实测：反编译后 CustomAction 表为空，
      而构建日志一条警告都没有）。这类"静默不生效"只能靠解包反编译发现。

      条件：
        · NOT REMOVE —— 卸载时不弹；
        · UILevel >= 3 —— 静默安装（/qn，UILevel=2）时不弹，
          否则在无人值守部署里会突然弹出一个浏览器窗口。
    -->
    <InstallExecuteSequence>
      <Custom Action="OpenConnectGuide" After="InstallFinalize"
              Condition="NOT REMOVE AND UILevel &gt;= 3" />

      <!--
        删除数据目录（F14.1 的"勾选后卸载结束删除整个 ProgramData\TavernCardStudio"）。

        时序：StopServices（ServiceControl Stop 在这里跑，服务先停）之后、
        RemoveFiles 之前 —— 数据文件先走，安装目录随后被 MSI 正常清理，
        两边不会互相踩。这与 F14.2 要求的顺序（停服务 → 删数据 → 删安装目录残留
        → 删服务注册）一致，后两步由 MSI 自身的 RemoveFiles / ServiceControl Remove 完成。

        Return="ignore"：删不掉（例如某个日志文件还被句柄占着）**不能**让卸载失败并回滚。
        回滚会得到一个"卸不掉"的安装，比"留下一个目录"糟糕得多；而数据保留的方向
        也是保守的（用户还可以手删）。失败痕迹由 T10.23 的清单式清理动作统一落日志。
      -->
      <Custom Action="DeleteDataDir" Before="RemoveFiles"
              Condition="REMOVE=&quot;ALL&quot; AND DELETEDATA=1" />
    </InstallExecuteSequence>
  </Package>

  <!-- Data directory: created at install, kept at uninstall unless DELETEDATA=1. -->
  <Fragment>
    <DirectoryRef Id="DATAFOLDER">
      <Component Id="DataFolderComponent" Guid="2C0B8B6A-6E5F-4B3D-9E44-8A7D1C3F5B21">
        <CreateFolder />
        <RegistryValue Root="HKLM" Key="Software\TavernCardStudio" Name="DataDir" Type="string" Value="[DATAFOLDER]" KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>

  <!--
    Service host.

    node.exe is NOT a service host: it never calls StartServiceCtrlDispatcher, so
    the SCM waits forever for SERVICE_RUNNING and the service stays `Start Pending`.
    With <ServiceInstall> pointing at node.exe directly, msiexec hangs at
    "Please wait while Windows configures ..." (reproduced 2026-10-21; the node
    process was up and listening on 8730/8731 the whole time, which made it look
    like a hang in the wrong place).

    Fix: WinSW (vendor\winsw\WinSW.NET4.exe, 832 KiB) is the SCM-facing process;
    it spawns node.exe from tcs-service-host.xml, reports RUNNING, captures
    stdout/stderr to %ProgramData%\TavernCardStudio\logs, and restarts on failure.

    Component GUID changed on purpose: KeyPath moved from node.exe to the host exe,
    and a component's resources must stay fixed for a given GUID.
  -->
  <Fragment>
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="ServiceComponent" Guid="03336D46-B75F-4A36-8605-B60D664DEF28">
        <File Id="NodeExe" Source="$(var.StageDir)\node.exe" />
        <File Id="ServiceHostExe" Source="$(var.WinSwDir)\WinSW.NET4.exe" Name="tcs-service-host.exe" KeyPath="yes" />
        <File Id="ServiceHostConfig" Source="$(var.ServiceHostConfig)" Name="tcs-service-host.xml" />
        <ServiceInstall
          Id="ServerServiceInstaller"
          Name="TavernCardStudioServer"
          DisplayName="Tavern Card Studio Server"
          Description="Tavern Card Studio: character card storage, audit and git-based version control."
          Type="ownProcess"
          Start="auto"
          ErrorControl="normal"
          Account="LocalSystem" />
        <!--
          No Arguments on purpose. WinSW v2 does NOT accept a config path as a
          command-line argument: it looks for `<exe-name>.xml` next to itself and
          aborts with "Unable to locate WinSW.NET4.[xml|yml] file within executable
          directory" otherwise (verified by running the trial config directly).
          So the pairing is name-based and must stay exact:
              tcs-service-host.exe  <->  tcs-service-host.xml
          Renaming only one of them silently breaks the service.
        -->
        <ServiceControl
          Id="ServerServiceControl"
          Name="TavernCardStudioServer"
          Start="install"
          Stop="both"
          Remove="uninstall"
          Wait="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>

  <!--
    Connect guide.

    装完服务端后，用户最需要知道的两件事是「面板地址」和「令牌在哪」。
    以前这两条只写在 docs/09 里（"令牌见 ProgramData\\...\\logs 下日志"），
    用户得自己去找 —— 现在改成装完直接给他看。

    为什么用 HTML + 安装完成后打开，而不是服务启动时弹窗：
    服务由 WinSW 托管、以 LocalSystem 跑在 **session 0**，
    与用户桌面不在同一个会话里，弹不出任何窗口（这正是 F5 里
    "进程活着、端口通、但 SCM 认为没启动" 那段排查时踩到的同一个隔离）。
    能弹窗的只有 msiexec —— 它跑在用户的会话里。所以指引必须由安装程序来打开。

    两个入口都保留：
      · 安装完成后自动打开（CustomAction，异步且不等待，失败不影响安装结果）；
      · 开始菜单快捷方式，用户以后想再看一次也能找到。
  -->
  <Fragment>
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="ConnectGuideComponent" Guid="8E4A1C72-93B5-4D68-A1F7-6C2D9B4E7053">
        <File Id="ConnectGuideHtml" Source="$(var.ConnectGuide)" Name="connect-guide.html" KeyPath="yes" />
      </Component>

      <!--
        安装布局标记（v0.1.2 追加任务）。

        为什么需要它：`.cmd` 启动器要判断"这是 MSI 安装还是绿色包"，才能选对配置文件
        （安装版在 %ProgramData%\TavernCardStudio，绿色包在 %BASE%\data）。
        之前用"data\config.json 是否存在"来猜 —— 那是**猜**：绿色包跑过一次就会有这个文件，
        而 MSI 安装版一旦被误跑一次也会生成，猜错就写进另一个库，两处都不报错。

        为什么不用"同级有没有 tcs-service-host.exe"：绿色包同样带那个 exe（服务注册用），
        两边完全一样，区分不了。所以改成显式标记：只有 MSI 才装这个文件。
      -->
      <Component Id="LayoutMarkerComponent" Guid="C41E7A93-62D8-4F15-B0A7-3E9D5C81F204">
        <File Id="InstallLayoutIni" Source="$(var.LayoutMarker)" Name="install-layout.ini" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="Tavern Card Studio Server" />
    </StandardDirectory>

    <DirectoryRef Id="AppMenuFolder">
      <Component Id="StartMenuShortcutComponent" Guid="B3F72D91-5A86-4E3C-8D27-1F4B6A9C2E58">
        <Shortcut
          Id="ConnectGuideShortcut"
          Name="如何连接（地址与令牌）"
          Description="打开连接说明：管理面板地址、API 地址、访问令牌的获取方式"
          Target="[INSTALLFOLDER]connect-guide.html" />
        <RemoveFolder Id="RemoveAppMenuFolder" On="uninstall" />
        <!-- 快捷方式需要一个 KeyPath；用注册表值作为锚点，避免依赖文件是否存在 -->
        <RegistryValue Root="HKLM" Key="Software\TavernCardStudio" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>

  <!--
    安装完成后打开说明页。

    用 `[%ComSpec] /c start "" "<file>"`：靠 shell 关联调起默认浏览器。
    直接写文件路径不行 —— CustomAction 的 ExeCommand 只能执行程序，不能"打开文档"。

    `Return="asyncNoWait"` 是有意的：说明页打不开（例如默认浏览器被策略限制）
    绝不能连带把安装判成失败。装好了就是装好了。
  -->
  <Fragment>
    <CustomAction
      Id="OpenConnectGuide"
      Directory="INSTALLFOLDER"
      ExeCommand="[%ComSpec] /c start &quot;&quot; &quot;[INSTALLFOLDER]connect-guide.html&quot;"
      Execute="immediate"
      Impersonate="yes"
      Return="asyncNoWait" />
  </Fragment>

  <!--
    删除数据目录（仅当用户在 DeleteDataDlg 里勾了框）。

    Deferred + Impersonate="yes"：
      · deferred：必须在脚本生成之后执行，否则它会在"还没停服务"时就去删数据；
      · impersonate：卸载程序由用户提权运行，此时该用户对 ProgramData 下的目录
        有删除权限。用 SYSTEM（Impersonate="no"）也能删，但 `%…%` 与用户态路径
        的解析会跑到 systemprofile 下，对客户端 MSI 那套 %APPDATA% 逻辑是错的 ——
        两套 MSI 用同一套写法，读起来才不容易搞混。

    Deferred 动作的命令行在**排程时**展开（[DATAFOLDER] 那时已经确定），
    所以这里可以直接写属性引用。

    `if exist` 兜底：数据目录本来就不存在时 rmdir 会返回非零，看着像失败。
  -->
  <Fragment>
    <CustomAction
      Id="DeleteDataDir"
      Directory="SystemFolder"
      Execute="deferred"
      Impersonate="yes"
      Return="ignore"
      ExeCommand="&quot;[SystemFolder]cmd.exe&quot; /c if exist &quot;[DATAFOLDER]&quot; rmdir /s /q &quot;[DATAFOLDER]&quot;" />
  </Fragment>

</Wix>
