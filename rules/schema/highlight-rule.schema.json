{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tavern-card-studio.local/schema/highlight-rule.schema.json",
  "title": "语法高亮规则文件（Highlight Rule）",
  "description": "描述一块文本编辑器里「什么内容显示成什么样式」。文件由编辑器直接加载，不改变角色卡数据。",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "version", "theme", "scopes", "rules"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1, "description": "格式版本，当前固定为 1。" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$", "description": "规则集唯一标识。" },
    "name": { "type": "string", "minLength": 1, "maxLength": 64, "description": "显示名称，如「默认（酒馆风）」。" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$", "description": "语义化版本。" },
    "description": { "type": "string", "maxLength": 2000, "description": "规则集说明与适用场景。" },
    "extends": { "type": ["string", "null"], "default": null, "description": "继承的规则集 id，子规则集在其基础上追加/覆盖同名规则。" },
    "editor": {
      "type": "object",
      "description": "编辑器排版参数（可选，随规则集切换）。",
      "additionalProperties": false,
      "properties": {
        "fontFamily": { "type": "string", "maxLength": 200, "description": "CSS font-family。" },
        "fontSize": { "type": "number", "minimum": 8, "maximum": 48, "description": "字号（px）。" },
        "lineHeight": { "type": "number", "minimum": 1, "maximum": 3, "description": "行高倍数。" },
        "tabSize": { "type": "integer", "minimum": 1, "maximum": 8, "description": "Tab 宽度（空格数）。" }
      }
    },
    "theme": {
      "type": "object",
      "description": "编辑器基础配色。",
      "required": ["foreground", "background"],
      "additionalProperties": false,
      "properties": {
        "foreground": { "$ref": "#/definitions/color", "description": "正文文字色。" },
        "background": { "$ref": "#/definitions/color", "description": "编辑器背景色。" },
        "caret": { "$ref": "#/definitions/color", "description": "光标颜色。" },
        "selectionBackground": { "$ref": "#/definitions/color", "description": "选中区域背景色。" }
      }
    },
    "scopes": {
      "type": "array",
      "description": "样式集合：每条规则通过 scope 引用这里的 id。",
      "minItems": 1,
      "items": { "$ref": "#/definitions/scope" }
    },
    "rules": {
      "type": "array",
      "description": "匹配规则：决定哪些文本属于哪个 scope。",
      "items": { "$ref": "#/definitions/rule" }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "author": { "type": "string", "maxLength": 64 },
        "homepage": { "type": "string", "maxLength": 256 },
        "license": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}" }
      }
    }
  },
  "definitions": {
    "color": {
      "type": "string",
      "description": "颜色值，支持 #RGB / #RRGGBB / #RRGGBBAA / rgba() / 具名颜色。",
      "pattern": "^(#[0-9a-fA-F]{3,8}|rgba?\\([^)]+\\)|[a-zA-Z]{3,20})$"
    },
    "scope": {
      "type": "object",
      "required": ["id", "label", "color"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,47}$", "description": "样式 id，规则通过它引用。" },
        "label": { "type": "string", "minLength": 1, "maxLength": 48, "description": "样式说明，如「占位符」。" },
        "color": { "$ref": "#/definitions/color", "description": "文字颜色。" },
        "backgroundColor": {
          "oneOf": [{ "$ref": "#/definitions/color" }, { "type": "null" }],
          "description": "背景高亮色，null 表示不设置背景。"
        },
        "bold": { "type": "boolean", "default": false, "description": "是否加粗。" },
        "italic": { "type": "boolean", "default": false, "description": "是否斜体。" },
        "underline": { "type": "boolean", "default": false, "description": "是否下划线。" },
        "strikethrough": { "type": "boolean", "default": false, "description": "是否删除线。" }
      }
    },
    "match": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["regex", "word-list", "line-prefix", "delimiter-block"],
          "description": "匹配方式：正则 / 关键字 / 行首前缀 / 成对分隔符区块。"
        },
        "pattern": { "type": "string", "minLength": 1, "description": "type=regex 时的正则（ECMAScript）。" },
        "flags": { "type": "string", "pattern": "^[gimsu]*$", "description": "type=regex 时的正则标志，默认 \"g\"。" },
        "wholeLine": { "type": "boolean", "default": false, "description": "type=regex 时，命中整行而非仅命中片段。" },
        "words": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 64 },
          "description": "type=word-list 的关键字表（字面量，自动转义）。"
        },
        "caseSensitive": { "type": "boolean", "default": false, "description": "type=word-list 是否区分大小写。" },
        "wholeWord": { "type": "boolean", "default": true, "description": "type=word-list 是否要求整词匹配（对中文无效）。" },
        "prefix": { "type": "string", "minLength": 1, "maxLength": 32, "description": "type=line-prefix 的行首标记，如 \"## \"。" },
        "open": { "type": "string", "minLength": 1, "maxLength": 16, "description": "type=delimiter-block 的起始分隔符，如 \"{{\"。" },
        "close": { "type": "string", "minLength": 1, "maxLength": 16, "description": "type=delimiter-block 的结束分隔符，如 \"}}\"。" }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "regex" } }, "required": ["type"] }, "then": { "required": ["pattern"] } },
        { "if": { "properties": { "type": { "const": "word-list" } }, "required": ["type"] }, "then": { "required": ["words"] } },
        { "if": { "properties": { "type": { "const": "line-prefix" } }, "required": ["type"] }, "then": { "required": ["prefix"] } },
        { "if": { "properties": { "type": { "const": "delimiter-block" } }, "required": ["type"] }, "then": { "required": ["open", "close"] } }
      ]
    },
    "rule": {
      "type": "object",
      "required": ["id", "scope", "match"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$", "description": "规则 id，同一文件内唯一。" },
        "scope": { "type": "string", "description": "引用的样式 id（必须是 scopes 中已存在的 id）。" },
        "match": { "$ref": "#/definitions/match" },
        "priority": { "type": "integer", "minimum": -1000, "maximum": 1000, "default": 0, "description": "优先级，越大越优先；同优先级时更长的匹配胜出。" },
        "appliesTo": {
          "oneOf": [
            { "$ref": "#/definitions/selector" },
            { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/selector" } }
          ],
          "description": "仅在这些板块/字段内生效，缺省为全部。"
        },
        "enabled": { "type": "boolean", "default": true, "description": "false 时临时禁用。" }
      }
    },
    "selector": {
      "type": "string",
      "pattern": "^(\\*|block:(basic|personality|settings|special|user|chat-examples|initial-scene|worldbook)|field:[a-z_]+)$",
      "description": "\"*\" / \"block:<id>\" / \"field:<ST字段名>\"。"
    }
  }
}
